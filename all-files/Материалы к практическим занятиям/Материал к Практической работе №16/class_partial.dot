digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
p [label="{DocumentProcessor||+ process(Document) ProcessingResult\l}", fillcolor="#F7FBFF", color="#2F5597"];
b [label="{BatchProcessor\nTODO|- executor ExecutorService\l|+ processAll(List[Document]) BatchResult\l}", fillcolor="#FDE9E7", color="#C00000"];
res [label="{BatchResult\nTODO|- successCount AtomicInteger\l- errors ConcurrentMap\l|+ registerSuccess()\l+ registerError(...)\l}", fillcolor="#FDE9E7", color="#C00000"];
b -> p [label="uses",arrowtail=odiamond,dir=both];
b -> res [label="returns",style=dashed,arrowhead=open];
}