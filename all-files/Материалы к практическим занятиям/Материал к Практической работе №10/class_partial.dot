digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
p [label="{DeliveryPolicy||+ supports(DeliveryRequest) boolean\l+ calculateCost(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
std [label="{StandardCourierPolicy\nTODO||+ supports(...)\l+ calculateCost(...)\l}", fillcolor="#FDE9E7", color="#C00000"];
exp [label="{ExpressPolicy\nTODO||+ supports(...)\l+ calculateCost(...)\l}", fillcolor="#FDE9E7", color="#C00000"];
pick [label="{PickupPolicy\nTODO||+ supports(...)\l+ calculateCost(...)\l}", fillcolor="#FDE9E7", color="#C00000"];
f [label="{DeliveryPolicyFactory\nTODO||+ get(DeliveryType) DeliveryPolicy\l}", fillcolor="#FDE9E7", color="#C00000"];
s [label="{DeliveryService|- factory DeliveryPolicyFactory\l|+ calculate(DeliveryRequest) double\l}", fillcolor="#F7FBFF", color="#2F5597"];
std -> p [label="implements",arrowhead=empty,style=dashed];
exp -> p [label="implements",arrowhead=empty,style=dashed];
pick -> p [label="implements",arrowhead=empty,style=dashed];
f -> p [label="creates",style=dashed,arrowhead=open];
s -> f [label="1",arrowtail=odiamond,dir=both];
}