digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Открыть файл" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n2 [label="Файл доступен" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n3 [label="Читать следующую строку" ];
n4 [label="Есть строка" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n5 [label="TODO A1 Разобрать и проверить одну строку" ,fillcolor="#F4CCCC",color="#C00000",style="rounded,dashed,filled"];
n6 [label="Строка корректна" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n7 [label="Сохранить Client" ];
n8 [label="Записать ошибку строки" ];
n9 [label="TODO A2 Сформировать ImportResult" ,fillcolor="#F4CCCC",color="#C00000",style="rounded,dashed,filled"];
n10 [label="Вернуть ошибку файла" ];
start -> n1;
n1 -> n2;
n2 -> n3 [label="да"];
n2 -> n10 [label="нет"];
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> n9 [label="нет"];
n5 -> n6;
n6 -> n7 [label="да"];
n6 -> n8 [label="нет"];
n7 -> n3;
n8 -> n3;
n9 -> end;
n10 -> end;
}